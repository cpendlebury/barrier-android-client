<?xml version="1.0" encoding="utf-8"?>
<!--
  Barrier Android client. The computer runs the Barrier server. This app is
  the phone-side client. It does not share the phone's keyboard upstream.

  Accessibility service: now registered with meta-data pointing at
  res/xml/accessibility_service_config.xml (canRetrieveWindowContent and
  canPerformGestures enabled). The service should now appear in
  Settings → Accessibility. isEnabled() checks secure settings; it still
  returns false until the user toggles it on.

  Foreground service: type specialUse without a PROPERTY_SPECIAL_USE_FGS_SUBTYPE
  property. Android 14+ can reject the start. The service also calls APIs
  newer than minSdk 22. See BarrierForegroundService.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/barrier_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/barrier_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.BarrierAndroid"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BarrierAndroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".accessibility.BarrierAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <service
            android:name=".BarrierForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="input injection" />
        </service>
    </application>

</manifest>
